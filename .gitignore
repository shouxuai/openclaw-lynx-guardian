# -------------------------- Node.js 核心依赖 --------------------------
# 项目依赖目录（npm install 生成）
node_modules/
# npm 调试日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# 包管理锁文件（可选忽略，建议团队统一规范后决定是否忽略）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# npm 全局安装的包缓存
node_cache/

# -------------------------- 前端构建产物 --------------------------
# 通用构建目录
dist/
build/
out/
# Vue 项目构建/开发产物
*.js.map
*.css.map
vue.config.js.env
# React 项目构建产物
coverage/
# Vite 项目临时文件
.vite/
# Webpack 临时配置/产物
webpack-stats.json
# 打包压缩文件
*.zip
*.tar.gz
*.rar
.claude
# -------------------------- 编辑器/IDE 配置 --------------------------
# VSCode
.vscode/
*.code-workspace
# WebStorm/IntelliJ
.idea/
*.iml
*.ipr
*.iws
# Sublime Text
*.sublime-project
*.sublime-workspace
# Vim
*.swp
*.swo
# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

